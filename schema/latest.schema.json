{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WelshPigeon/pigeon-resource-versions/main/schema/latest.schema.json",
  "title": "Pigeon Studios Group Resource Version",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "slug",
    "name",
    "status",
    "version",
    "released_at",
    "title",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["active", "deprecated", "archived"]
    },
    "repository": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string"
    },
    "released_at": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
